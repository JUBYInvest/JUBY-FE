# 이 파일을 .env로 복사해서 쓴다. .env는 .gitignore에 걸려 있어 커밋되지 않는다.

# API 호출용. 비워두면 vite.config.ts의 프록시를 타서 CORS를 우회한다
VITE_API_BASE_URL=

# OAuth 이동 전용. 브라우저 주소창이 직접 찾아가는 곳이라 프록시를 탈 수 없어 절대주소가 필요하다
VITE_API_ORIGIN=https://api.juby.store

# 커뮤니티 웹소켓(STOMP) 주소. 예: wss://api.juby.store/ws — 비워두면 예시 글을 흘려보내는 목업이다(src/api/community.ts, docs/커뮤니티-웹소켓-제안.md)
VITE_COMMUNITY_WS_URL=
